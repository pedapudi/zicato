  "note_progress": [
    {
      "seq": 1,
      "last": -1,
      "expect": {
        "advanced": true,
        "rollover": false,
        "present": true
      },
      "why": "first seq ever seen — adopt it and paint"
    },
    {
      "seq": 9,
      "last": 8,
      "expect": {
        "advanced": true,
        "rollover": false,
        "present": true
      },
      "why": "forward progress"
    },
    {
      "seq": 8,
      "last": 8,
      "expect": {
        "advanced": false,
        "rollover": false,
        "present": true
      },
      "why": "THE no-op beat: repeated seq ⇒ zero fetch, zero patch"
    },
    {
      "seq": 1,
      "last": 90,
      "expect": {
        "advanced": false,
        "rollover": true,
        "present": true
      },
      "why": "backwards ⇒ the log was cleared on a fresh evolve boot; force a full re-apply"
    },
    {
      "seq": 0,
      "last": -1,
      "expect": {
        "advanced": true,
        "rollover": false,
        "present": true
      },
      "why": "seq 0 is a legal first cursor, not a falsy absence"
    },
    {
      "seq": null,
      "last": 4,
      "expect": {
        "advanced": false,
        "rollover": false,
        "present": false
      },
      "why": "absent seq ⇒ DEGRADE to the legacy always-refresh path"
    },
    {
      "seq": "3",
      "last": 4,
      "expect": {
        "advanced": false,
        "rollover": false,
        "present": false
      },
      "why": "a non-numeric seq is absent, never coerced"
    }
  ]
