# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtualenvs
.venv/
venv/
env/

# Test / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
# The line-budget history cache (tools/line_budget.py --history): per-blob and
# per-commit counts that are content-addressed and rebuilt on demand.
.cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
.claude/

# Zicato workspace (per-project state)
.zicato/

# Per-workspace harmonograf data (sqlite db + payloads + server record).
# Travels with the workspace like .zicato/; never committed.
.harmonograf/

# Target run output — agents write rendered artifacts here at run time.
# This is exactly the artifact leak the snapshot-scope fix targets:
# generation snapshots stay code-only, so run output is never committed.
examples/target_1_presentation/agent/output/

# Per-run scratch directories (zicato routes run output here, outside
# every generation snapshot — see zicato/epoch/snapshot_scope.py).
.zicato-scratch/

# Rust / Cargo build artifacts. The Cargo workspace builds every crate
# into a single target/ directory at the repo root.
/target/

# The supervisor binary the hatchling build hook compiles and stages
# into the wheel. Generated at build time — never committed.
src/zicato/_bin/

# The pinned pi runtime for the external proposer (integrations/pi).
# The PIN lives in git (package.json + package-lock.json); the BYTES
# arrive via `npm ci`, exactly like uv.lock and .venv.
node_modules/
# npm regenerates this on install; the reproducible pin is the exact
# version in integrations/pi/package.json plus the publisher's own
# npm-shrinkwrap.json, which pins every transitive dependency.
package-lock.json
